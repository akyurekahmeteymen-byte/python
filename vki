boy=float(input("Lütfen Boyunuzu Metre Cinsinden Giriniz:"))
kütle=float(input("Lütfen Kilonuzu Kilogram Cinsinden Giriniz:"))
vki=(kütle/boy**2)
print(f"Vücut Kitle İndeksiniz: {vki}")
if vki<18.5:
  print("Zayıf (Düşük Kilo)")
elif 18.5<=vki<=24.9:
  print("Normal (Sağlıklı Kilo)")
elif 25.0<=vki<=29.9:
  print("Fazla Kilolu (Şişman)")
elif vki>30.0:
  print("Obez")
